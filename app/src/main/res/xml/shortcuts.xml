<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="shortcut_screen_off"
        android:enabled="true"
        android:icon="@drawable/ic_oled_off"
        android:shortcutShortLabel="@string/shortcut_screen_off_short"
        android:shortcutLongLabel="@string/shortcut_screen_off_long">
        <intent
            android:action="com.modernlghub.remote.action.SHORTCUT"
            android:targetPackage="com.modernlghub.remote"
            android:targetClass="com.modernlghub.remote.system.ShortcutActionActivity">
            <extra android:name="action" android:value="screen_toggle" />
        </intent>
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

    <shortcut
        android:shortcutId="shortcut_pc"
        android:enabled="true"
        android:icon="@drawable/ic_pc"
        android:shortcutShortLabel="@string/shortcut_pc_short"
        android:shortcutLongLabel="@string/shortcut_pc_long">
        <intent
            android:action="com.modernlghub.remote.action.SHORTCUT"
            android:targetPackage="com.modernlghub.remote"
            android:targetClass="com.modernlghub.remote.system.ShortcutActionActivity">
            <extra android:name="action" android:value="pc" />
        </intent>
    </shortcut>

    <shortcut
        android:shortcutId="shortcut_overlay"
        android:enabled="true"
        android:icon="@drawable/ic_remote"
        android:shortcutShortLabel="@string/shortcut_overlay_short"
        android:shortcutLongLabel="@string/shortcut_overlay_long">
        <intent
            android:action="com.modernlghub.remote.action.SHORTCUT"
            android:targetPackage="com.modernlghub.remote"
            android:targetClass="com.modernlghub.remote.system.QuickRemoteOverlayActivity" />
    </shortcut>
</shortcuts>
