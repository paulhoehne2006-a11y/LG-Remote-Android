<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Not used for any API call: on Android 14+ a "connectedDevice" foreground service
         (TvPresenceService) requires one of a fixed list of permissions, and this is the least
         powerful one on it. (ACCESS_WIFI_STATE and CHANGE_WIFI_MULTICAST_STATE were unused.) -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- Speech recognition for the assistant (RecognizerIntent). -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".ModernLgApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ModernLgRemote">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Floating mini remote (Quick Settings tile, widget, notification, shortcut). -->
        <activity
            android:name=".system.QuickRemoteOverlayActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/overlay_label"
            android:launchMode="singleTask"
            android:taskAffinity="com.modernlghub.remote.overlay"
            android:theme="@style/Theme.ModernLgRemote.Overlay">
            <intent-filter>
                <action android:name="com.modernlghub.remote.action.OVERLAY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Headless target for launcher shortcuts and Samsung Modes & Routines. Exported on
             purpose; only known action keys are accepted (ShortcutActionActivity.actionOf). -->
        <activity
            android:name=".system.ShortcutActionActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.ModernLgRemote.Transparent">
            <intent-filter>
                <action android:name="com.modernlghub.remote.action.SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".system.TvQuickTileService"
            android:exported="true"
            android:icon="@drawable/ic_remote"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <service
            android:name=".system.TvPresenceService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Runs widget / shortcut actions. Not exported: only our own PendingIntents reach it. -->
        <receiver
            android:name=".system.TvActionReceiver"
            android:exported="false" />

        <!-- Exported because the system delivers widget updates; it does not act on clicks. -->
        <receiver
            android:name=".system.TvRemoteWidgetProvider"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_remote_info" />
        </receiver>

    </application>

</manifest>
